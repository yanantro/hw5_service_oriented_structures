{
  "uid": "cinema",
  "title": "Online Cinema Analytics",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Retention Cohort Heatmap",
      "type": "table",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT toString(date) AS Cohort, maxIf(value * 100, dimension = '0') AS `Day 0`, maxIf(value * 100, dimension = '1') AS `Day 1`, maxIf(value * 100, dimension = '2') AS `Day 2`, maxIf(value * 100, dimension = '3') AS `Day 3`, maxIf(value * 100, dimension = '4') AS `Day 4`, maxIf(value * 100, dimension = '5') AS `Day 5`, maxIf(value * 100, dimension = '6') AS `Day 6`, maxIf(value * 100, dimension = '7') AS `Day 7` FROM cinema.metrics WHERE metric = 'retention' AND $__dateFilter(date) GROUP BY date HAVING countIf(dimension = '0' AND isNotNull(value)) > 0 ORDER BY date DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "color": {
            "mode": "continuous-RdYlGr"
          },
          "custom": {
            "cellOptions": {
              "type": "color-background"
            },
            "align": "center",
            "minWidth": 60
          },
          "noValue": "—",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "—",
                  "color": "#30343b"
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cohort"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "unit",
                "value": "string"
              },
              {
                "id": "custom.width",
                "value": 125
              },
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "description": "Когорта — дата первого просмотра. В таблице только непустые когорты за выбранный период. Прочерк означает, что день ещё не наступил."
    },
    {
      "id": 2,
      "title": "DAU",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT toDateTime(date) AS time, value FROM cinema.metrics WHERE metric = 'dau' AND $__dateFilter(date) ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Конверсия",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT toDateTime(date) AS time, value FROM cinema.metrics WHERE metric = 'conversion' AND $__dateFilter(date) ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Среднее время просмотра",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT toDateTime(date) AS time, value FROM cinema.metrics WHERE metric = 'avg_watch_seconds' AND $__dateFilter(date) ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "Топ фильмов за последний день",
      "type": "barchart",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "queryType": "table",
          "format": 1,
          "rawSql": "SELECT dimension AS movie, value AS views FROM cinema.metrics WHERE metric = 'movie_views' AND date = (SELECT max(date) FROM cinema.metrics WHERE metric = 'movie_views' AND $__dateFilter(date)) ORDER BY views DESC LIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
